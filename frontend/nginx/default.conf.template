# A imagem oficial do nginx roda o envsubst neste template ao subir o container.
# Só variáveis de ambiente definidas são trocadas; as do nginx ($host, $uri...) ficam intactas.

# Atras do Caddy o nginx recebe HTTP puro; o esquema publico chega no cabecalho.
# So "https" e aceito: um valor forjado afetaria apenas as URLs da propria resposta.
map $http_x_forwarded_proto $esquema_publico {
    default $scheme;
    https   https;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Teto do POST /jobs (MAX_UPLOAD_MB) com folga para o envelope multipart;
    # a conta é feita em 10-limites.envsh.
    client_max_body_size ${NGINX_MAX_BODY_MB}m;

    # Proxy confiável na frente (Caddy, balanceador da nuvem): só conexões vindas
    # de TRUSTED_PROXY_CIDR têm o X-Forwarded-For lido, e aí $remote_addr passa a
    # ser o IP do cliente. O padrão 127.0.0.1/32 desliga na prática: sem proxy na
    # frente, nenhuma conexão chega desse endereço e o cabeçalho é ignorado.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Herdado pelas locations de /api. A chave existe só aqui no servidor,
    # nunca no bundle do navegador.
    proxy_http_version 1.1;
    proxy_set_header X-API-Key "${CONVERSOR_API_KEY}";
    # Sobrescreve em vez de anexar: um X-Forwarded-For forjado pelo cliente não
    # chega ao rate limit da API. Com o realip acima, $remote_addr já é o IP do
    # cliente mesmo atrás de um proxy confiável.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $esquema_publico;
    # Host público e prefixo removido no rewrite: sem eles, as URLs que a API
    # devolve (status_url) apontariam para http://api:8000, que só existe na
    # rede dos containers.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Prefix /api;
    # Upload e download em streaming, sem copiar o arquivo inteiro para disco.
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Só as rotas que o front usa. Como a chave é injetada aqui, liberar /api/
    # inteiro exporia a listagem de jobs de todos os usuários.
    location = /api/jobs {
        limit_except POST {
            deny all;
        }
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
    }

    location ~ "^/api/jobs/[0-9a-fA-F-]{36}(/download)?$" {
        limit_except GET {
            deny all;
        }
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
    }

    location /api/ {
        return 404;
    }

    # Limites que o front lê ao carregar, vindos das mesmas variáveis da API.
    # Mudar o limite não exige rebuild da imagem.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-cache";
        return 200 '{"maxUploadMb": ${MAX_UPLOAD_MB}}';
    }

    # Arquivos do build têm hash no nome: cache longo é seguro.
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}

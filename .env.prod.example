# Copie para .env.prod (fora do git) e troque todos os "troque-me". Subir com:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ==== Acesso publico ====
# Dominio que aponta para a VM. Com localhost o Caddy usa certificado local
# (o navegador avisa); com dominio real, emite Let's Encrypt sozinho.
DOMAIN=localhost

# Basic auth na frente de tudo. Gere o hash com:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'sua-senha'
# Aspas simples obrigatorias: o hash tem "$" e o compose tentaria interpolar.
BASIC_AUTH_USER=demo
BASIC_AUTH_HASH='troque-me'

# ==== Banco e fila ====
POSTGRES_USER=conversor
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=conversor
DATABASE_URL=postgresql+psycopg://conversor:troque-me@postgres:5432/conversor

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RATE_LIMIT_STORAGE_URL=redis://redis:6379/2

# ==== Storage ====
# Senha do MinIO precisa de 8+ caracteres.
MINIO_ROOT_USER=conversor
MINIO_ROOT_PASSWORD=troque-me-123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=conversor
MINIO_SECRET_KEY=troque-me-123
# MinIO nao e exposto: sem endereco publico, o download sai por download_url.
MINIO_PUBLIC_ENDPOINT=

# ==== Webhook ====
WEBHOOK_SIGNING_SECRET=troque-me
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ==== Limites ====
MAX_UPLOAD_MB=100
# LibreOffice e FFmpeg pesam: numa VM de 4 GB, 1 conversao por vez.
CELERY_CONCURRENCY=1

# ==== Chaves ====
# A do front precisa estar em API_KEYS. A API nao tem porta publica: so o
# nginx do front a alcanca.
API_KEYS=troque-me
FRONTEND_API_KEY=troque-me

GRAFANA_ADMIN_PASSWORD=troque-me

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VERSION=1.8.4 \
    POETRY_VIRTUALENVS_CREATE=false \
    PIP_NO_CACHE_DIR=1 \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

WORKDIR /code

RUN apt-get update && apt-get install -y --no-install-recommends \
            build-essential \
            ffmpeg \
            tesseract-ocr \
            tesseract-ocr-eng \
            tesseract-ocr-por \
            libreoffice-writer-nogui \
            libreoffice-calc-nogui \
            libreoffice-impress-nogui \
            fonts-liberation \
        && rm -rf /var/lib/apt/lists/*

RUN pip install "poetry==${POETRY_VERSION}"

COPY pyproject.toml poetry.lock* /code/

RUN poetry install --no-interaction --no-ansi --no-root

COPY ./app /code/app

# Codigo continua do root (so leitura para o processo); /code fica do app
# apenas para caches de ferramentas como o .pytest_cache. O home existe
# porque o LibreOffice grava configuracao em $HOME.
RUN useradd --create-home --uid 10001 --user-group app \
    && chown app:app /code

# UID numerico: o runAsNonRoot do Kubernetes so consegue verificar numero.
USER 10001

CMD ["celery", "-A", "app.broker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]

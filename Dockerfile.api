FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VERSION=1.8.4 \
    POETRY_VIRTUALENVS_CREATE=false \
    PIP_NO_CACHE_DIR=1

WORKDIR /code

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install "poetry==${POETRY_VERSION}"

# Lock obrigatorio: sem ele o build resolveria os "^" na hora e cada imagem
# poderia sair com versoes diferentes.
COPY pyproject.toml poetry.lock /code/

RUN poetry install --no-interaction --no-ansi --no-root

COPY alembic.ini /code/alembic.ini
COPY ./migrations /code/migrations
COPY ./app /code/app

# Codigo continua do root (so leitura para o processo); /code fica do app
# apenas para caches de ferramentas como o .pytest_cache.
RUN useradd --create-home --uid 10001 --user-group app \
    && chown app:app /code

# UID numerico: o runAsNonRoot do Kubernetes so consegue verificar numero.
USER 10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]

# Certificado automatico: Let's Encrypt para dominio real; para localhost,
# CA interna do Caddy (o navegador avisa, mas o fluxo e o mesmo).
{$DOMAIN} {
	# Demo publica: tudo exige usuario e senha. So o hash bcrypt fica no
	# servidor (gerado com caddy hash-password).
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	redir /grafana /grafana/
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Front e /api: o nginx do front ja faz a allowlist de rotas e injeta a chave.
	handle {
		reverse_proxy frontend:8080
	}
}
